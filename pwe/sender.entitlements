<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shortcuts for "controlled by the receiver" run through System Events.
         Under the hardened runtime an app may send Apple events only with this. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
